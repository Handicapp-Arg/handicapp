# Entorno
NODE_ENV=development
PORT=3001
HOST=localhost

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=handicapp_db
DB_USER=handicapp_user
DB_PASSWORD=tu_password_aqui

# Autenticación / Seguridad (mínimo 64 caracteres)
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_minimo_64_caracteres_en_produccion
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Redis (opcional - comentar si no se usa)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# API
API_VERSION=v1
API_PREFIX=/api

# Archivos
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# SMTP / Email
APP_WEB_URL=http://localhost:3000
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=465
SMTP_USER=tu@email.com
SMTP_PASS=tu_password_smtp
SMTP_FROM_EMAIL=tu@email.com
SMTP_FROM_NAME=HandicApp

# Push Notifications (Web Push VAPID Keys)
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# Cloudinary (para imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
