{
  "name": "back-handicapp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "init": "ts-node scripts/setup/init-app.ts",
    "init-models": "ts-node src/scripts/init-models.ts",
    "diagnose": "ts-node src/utils/diagnose.ts",
    "seed": "ts-node -r tsconfig-paths/register -e \"import('./src/services/seedService').then(m => m.seedDatabase())\"",
    "seed:establecimientos": "ts-node -r tsconfig-paths/register scripts/seed-establecimientos-completos.ts",
    "seed:completo": "ts-node -r tsconfig-paths/register scripts/seed-completo.ts",
    "reset:db": "ts-node -r tsconfig-paths/register scripts/reset-database.ts",
    "sync": "ts-node scripts/maintenance/sync-safe.ts",
    "migrate": "node scripts/run-migration.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-pino-logger": "^7.0.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.10.0",
    "qrcode": "^1.5.4",
    "resend": "^6.4.1",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^11.0.6",
    "web-push": "^3.6.7",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/socket.io": "^3.0.2",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/ui": "^4.0.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "happy-dom": "^20.0.8",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.1"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}
