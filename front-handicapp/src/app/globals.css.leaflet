/* Leaflet CSS imports */
@import 'leaflet/dist/leaflet.css';

/* Custom map styles */
.leaflet-container {
  height: 100%;
  width: 100%;
  z-index: 0;
}

.custom-marker-icon {
  background: transparent;
  border: none;
}

.establecimiento-popup {
  min-width: 250px;
}

.establecimiento-popup .establecimiento-name {
  font-weight: 600;
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
  color: #1a202c;
}

.establecimiento-popup .establecimiento-rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}

.establecimiento-popup .establecimiento-location {
  font-size: 0.875rem;
  color: #718096;
  margin-bottom: 0.75rem;
}

.establecimiento-popup .establecimiento-verified {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  background-color: #48bb78;
  color: white;
  padding: 0.125rem 0.5rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 500;
}

.establecimiento-popup .popup-actions {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.75rem;
}

.establecimiento-popup .popup-actions button {
  flex: 1;
  padding: 0.5rem;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.establecimiento-popup .btn-primary {
  background-color: #4299e1;
  color: white;
  border: none;
}

.establecimiento-popup .btn-primary:hover {
  background-color: #3182ce;
}

.establecimiento-popup .btn-secondary {
  background-color: white;
  color: #4299e1;
  border: 1px solid #4299e1;
}

.establecimiento-popup .btn-secondary:hover {
  background-color: #ebf8ff;
}
